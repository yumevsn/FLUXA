{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the FLUXA web app may do on the desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-save",
    "fs:allow-write-file",
    "opener:allow-open-url"
  ]
}
